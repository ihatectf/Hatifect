{
  "schemaVersion": 1,
  "id": "flow.ui.player.input",
  "platform": "macos-quartz",
  "evidence": {
    "domain": {
      "path": "diagnostics/flow-player-input-progress.json",
      "identity": {
        "requestId": "${requestId}",
        "scenarioId": "${scenarioId}"
      }
    },
    "ui": {
      "path": "diagnostics/ui-window-input-progress.json",
      "identity": {
        "runId": "${requestId}",
        "scenario": "${scenarioId}"
      }
    }
  },
  "gameActive": {
    "source": "domain",
    "path": "inputTelemetry.latest.gameActive",
    "activateAppContains": "Stardew Valley"
  },
  "steps": [
    {"id":"game-active","op":"wait","timeout":60,"conditions":[{"source":"domain","path":"inputTelemetry.latest.gameActive","equals":true}]},
    {"id":"await-source-stage","op":"wait","timeout":90,"conditions":[{"source":"domain","path":"stage","equals":"ordinary-entry-source"}]},
    {"id":"capture-sourceName","op":"capture","source":"domain","path":"fixture.sourceName","variable":"sourceName","transform":"string"},
    {"id":"capture-destinationName","op":"capture","source":"domain","path":"fixture.destinationName","variable":"destinationName","transform":"string"},
    {"id":"capture-probeText","op":"capture","source":"domain","path":"fixture.probeText","variable":"probeText","transform":"string"},
    {"id":"move-source","op":"move","source":"domain","path":"fixture.sourceScreen"},
    {"id":"capture-source-entry-count","op":"capture","source":"domain","path":"entryAttempts","variable":"sourceEntryBefore","transform":"count"},
    {"id":"capture-source-opening-count","op":"capture","source":"domain","path":"openings","variable":"sourceOpenBefore","transform":"count"},
    {"id":"open-source-window","op":"key","key":"K"},
    {"id":"wait-source-opening","op":"wait","timeout":20,"conditions":[{"source":"domain","path":"entryAttempts","countGreaterThan":"${sourceEntryBefore}"},{"source":"domain","path":"openings","countGreaterThan":"${sourceOpenBefore}"}]},
    {"id":"assert-source-target","op":"assert","conditions":[{"source":"domain","path":"openings[-1].target","uuidZero":false}]},
    {"id":"wait-source-window","op":"waitUi","timeout":30,"visible":true,"experience":"Hatifect.Flow/network"},
    {"id":"wait-probe-ready","op":"wait","timeout":25,"conditions":[{"source":"ui","path":"phase","equals":"Ready"}]},
    {"id":"focus-probe-name","op":"focus","selector":{"semantic":"Hatifect.Flow/network/field/name"}},
    {"id":"wait-probe-pointer","op":"wait","timeout":25,"conditions":[{"source":"ui","path":"phase","equals":"Pointer"}]},
    {"id":"type-probe","op":"text","value":"${probeText}"},
    {"id":"wait-probe-text","op":"wait","timeout":25,"conditions":[{"source":"ui","path":"phase","equals":"Text"}]},
    {"id":"probe-backspace","op":"key","key":"Backspace"},
    {"id":"wait-probe-backspace","op":"wait","timeout":25,"conditions":[{"source":"ui","path":"phase","equals":"Backspace"}]},
    {"id":"probe-tab","op":"key","key":"Tab"},
    {"id":"wait-probe-complete","op":"wait","timeout":25,"conditions":[{"source":"ui","path":"phase","equals":"Complete"}]},
    {"id":"assert-native-phases","op":"assert","conditions":[{"source":"ui","path":"captures","containsAll":{"path":"phase","values":["Ready","Pointer","Text","Backspace","Tab"]}}]},
    {"id":"capture-busy-entry","op":"capture","source":"domain","path":"entryAttempts","variable":"busyEntryBefore","transform":"count"},
    {"id":"press-busy-k","op":"key","key":"K"},
    {"id":"wait-busy-rejection","op":"wait","timeout":15,"conditions":[{"source":"domain","path":"entryAttempts","countGreaterThan":"${busyEntryBefore}"}]},
    {"id":"assert-busy-rejection","op":"assert","conditions":[{"source":"domain","path":"entryAttempts[-1].menuOpen","equals":true},{"source":"domain","path":"entryAttempts[-1].guardsPassed","equals":false}]},
    {"id":"set-source-name","op":"fill","selector":{"semantic":"Hatifect.Flow/network/field/name"},"value":"${sourceName}"},
    {"id":"registerSource-command-before","op":"capture","source":"domain","path":"commands","variable":"registerSourceCommandBefore","transform":"count"},
    {"id":"registerSource-capture-before","op":"capture","source":"ui","path":"captures","variable":"registerSourceCaptureBefore","transform":"count"},
    {"id":"registerSource-activate","op":"activate","selector":{"action":"Hatifect.Flow/network/action/register"}},
    {"id":"registerSource-command-seen","op":"wait","timeout":20,"conditions":[{"source":"domain","path":"commands","countGreaterThan":"${registerSourceCommandBefore}"}]},
    {"id":"registerSource-result-ready","op":"waitElement","timeout":20,"visible":false,"selector":{"semantic":"Hatifect.Flow/network/element/result"},"conditions":[{"path":"value","truthy":true}]},
    {"id":"registerSource-result-reveal","op":"reveal","selector":{"semantic":"Hatifect.Flow/network/element/result"}},
    {"id":"registerSource-result-captured","op":"waitCapture","timeout":25,"path":"captures","afterCount":"${registerSourceCaptureBefore}","selector":{"semantic":"Hatifect.Flow/network/element/result"},"conditions":[{"path":"value","truthy":true}]},
    {"id":"registerSource-stage","op":"wait","timeout":30,"conditions":[{"source":"domain","path":"stage","equals":"ordinary-entry-destination"}]},
    {"id":"close-source-window","op":"key","key":"Escape"},
    {"id":"wait-source-closed","op":"waitUi","timeout":20,"visible":false},
    {"id":"move-destination","op":"move","source":"domain","path":"fixture.destinationScreen"},
    {"id":"capture-destination-entry-count","op":"capture","source":"domain","path":"entryAttempts","variable":"destEntryBefore","transform":"count"},
    {"id":"capture-destination-opening-count","op":"capture","source":"domain","path":"openings","variable":"destOpenBefore","transform":"count"},
    {"id":"open-destination-window","op":"key","key":"K"},
    {"id":"wait-destination-opening","op":"wait","timeout":20,"conditions":[{"source":"domain","path":"entryAttempts","countGreaterThan":"${destEntryBefore}"},{"source":"domain","path":"openings","countGreaterThan":"${destOpenBefore}"}]},
    {"id":"assert-destination-target","op":"assert","conditions":[{"source":"domain","path":"openings[-1].target","uuidZero":false}]},
    {"id":"wait-destination-window","op":"waitUi","timeout":30,"visible":true,"experience":"Hatifect.Flow/network"},
    {"id":"set-destination-name","op":"fill","selector":{"semantic":"Hatifect.Flow/network/field/name"},"value":"${destinationName}"},
    {"id":"registerDestination-command-before","op":"capture","source":"domain","path":"commands","variable":"registerDestinationCommandBefore","transform":"count"},
    {"id":"registerDestination-capture-before","op":"capture","source":"ui","path":"captures","variable":"registerDestinationCaptureBefore","transform":"count"},
    {"id":"registerDestination-activate","op":"activate","selector":{"action":"Hatifect.Flow/network/action/register"}},
    {"id":"registerDestination-command-seen","op":"wait","timeout":20,"conditions":[{"source":"domain","path":"commands","countGreaterThan":"${registerDestinationCommandBefore}"}]},
    {"id":"registerDestination-result-ready","op":"waitElement","timeout":20,"visible":false,"selector":{"semantic":"Hatifect.Flow/network/element/result"},"conditions":[{"path":"value","truthy":true}]},
    {"id":"registerDestination-result-reveal","op":"reveal","selector":{"semantic":"Hatifect.Flow/network/element/result"}},
    {"id":"registerDestination-result-captured","op":"waitCapture","timeout":25,"path":"captures","afterCount":"${registerDestinationCaptureBefore}","selector":{"semantic":"Hatifect.Flow/network/element/result"},"conditions":[{"path":"value","truthy":true}]},
    {"id":"registerDestination-stage","op":"wait","timeout":30,"conditions":[{"source":"domain","path":"stage","equals":"author-route"}]},
    {"id":"close-destination-window","op":"key","key":"Escape"},
    {"id":"wait-destination-closed","op":"waitUi","timeout":20,"visible":false},
    {"id":"move-empty","op":"move","source":"domain","path":"fixture.emptyScreen"},
    {"id":"capture-empty-entry-count","op":"capture","source":"domain","path":"entryAttempts","variable":"emptyEntryBefore","transform":"count"},
    {"id":"capture-empty-opening-count","op":"capture","source":"domain","path":"openings","variable":"emptyOpenBefore","transform":"count"},
    {"id":"open-empty-window","op":"key","key":"K"},
    {"id":"wait-empty-opening","op":"wait","timeout":20,"conditions":[{"source":"domain","path":"entryAttempts","countGreaterThan":"${emptyEntryBefore}"},{"source":"domain","path":"openings","countGreaterThan":"${emptyOpenBefore}"}]},
    {"id":"assert-empty-target","op":"assert","conditions":[{"source":"domain","path":"openings[-1].target","uuidZero":true}]},
    {"id":"wait-empty-window","op":"waitUi","timeout":30,"visible":true,"experience":"Hatifect.Flow/network"},
    {"id":"select-source-station","op":"select","collection":"Hatifect.Flow/network/element/source-station","selector":{"semanticPrefix":"Hatifect.Flow/network/source/","name":"${sourceName}"}},
    {"id":"select-destination-station","op":"select","collection":"Hatifect.Flow/network/element/destination-station","selector":{"semanticPrefix":"Hatifect.Flow/network/destination/","name":"${destinationName}"}},
    {"id":"wait-link-enabled","op":"waitElement","timeout":15,"selector":{"action":"Hatifect.Flow/network/action/link"},"conditions":[{"path":"enabled","equals":true}]},
    {"id":"addLink-command-before","op":"capture","source":"domain","path":"commands","variable":"addLinkCommandBefore","transform":"count"},
    {"id":"addLink-capture-before","op":"capture","source":"ui","path":"captures","variable":"addLinkCaptureBefore","transform":"count"},
    {"id":"addLink-activate","op":"activate","selector":{"action":"Hatifect.Flow/network/action/link"}},
    {"id":"addLink-command-seen","op":"wait","timeout":20,"conditions":[{"source":"domain","path":"commands","countGreaterThan":"${addLinkCommandBefore}"}]},
    {"id":"addLink-result-ready","op":"waitElement","timeout":20,"visible":false,"selector":{"semantic":"Hatifect.Flow/network/element/result"},"conditions":[{"path":"value","truthy":true}]},
    {"id":"addLink-result-reveal","op":"reveal","selector":{"semantic":"Hatifect.Flow/network/element/result"}},
    {"id":"addLink-result-captured","op":"waitCapture","timeout":25,"path":"captures","afterCount":"${addLinkCaptureBefore}","selector":{"semantic":"Hatifect.Flow/network/element/result"},"conditions":[{"path":"value","truthy":true}]},
    {"id":"addLink-stage","op":"wait","timeout":30,"conditions":[{"source":"domain","path":"stage","equals":"send-whole"}]},
    {"id":"select-whole-stack","op":"select","collection":"Hatifect.Flow/network/element/source-cargo","selector":{"semantic":"Hatifect.Flow/network/slot/0"}},
    {"id":"sendWhole-command-before","op":"capture","source":"domain","path":"commands","variable":"sendWholeCommandBefore","transform":"count"},
    {"id":"sendWhole-capture-before","op":"capture","source":"ui","path":"captures","variable":"sendWholeCaptureBefore","transform":"count"},
    {"id":"sendWhole-activate","op":"activate","selector":{"action":"Hatifect.Flow/network/action/send"}},
    {"id":"sendWhole-command-seen","op":"wait","timeout":20,"conditions":[{"source":"domain","path":"commands","countGreaterThan":"${sendWholeCommandBefore}"}]},
    {"id":"sendWhole-result-ready","op":"waitElement","timeout":20,"visible":false,"selector":{"semantic":"Hatifect.Flow/network/element/result"},"conditions":[{"path":"value","truthy":true}]},
    {"id":"sendWhole-result-reveal","op":"reveal","selector":{"semantic":"Hatifect.Flow/network/element/result"}},
    {"id":"sendWhole-result-captured","op":"waitCapture","timeout":25,"path":"captures","afterCount":"${sendWholeCaptureBefore}","selector":{"semantic":"Hatifect.Flow/network/element/result"},"conditions":[{"path":"value","truthy":true}]},
    {"id":"sendWhole-stage","op":"wait","timeout":30,"conditions":[{"source":"domain","path":"stage","equals":"send-five"}]},
    {"id":"select-partial-stack","op":"select","collection":"Hatifect.Flow/network/element/source-cargo","selector":{"semantic":"Hatifect.Flow/network/slot/1"}},
    {"id":"set-partial-quantity","op":"fill","selector":{"semantic":"Hatifect.Flow/network/field/quantity"},"value":"5"},
    {"id":"sendFive-command-before","op":"capture","source":"domain","path":"commands","variable":"sendFiveCommandBefore","transform":"count"},
    {"id":"sendFive-capture-before","op":"capture","source":"ui","path":"captures","variable":"sendFiveCaptureBefore","transform":"count"},
    {"id":"sendFive-activate","op":"activate","selector":{"action":"Hatifect.Flow/network/action/send-quantity"}},
    {"id":"sendFive-command-seen","op":"wait","timeout":20,"conditions":[{"source":"domain","path":"commands","countGreaterThan":"${sendFiveCommandBefore}"}]},
    {"id":"sendFive-result-ready","op":"waitElement","timeout":20,"visible":false,"selector":{"semantic":"Hatifect.Flow/network/element/result"},"conditions":[{"path":"value","truthy":true}]},
    {"id":"sendFive-result-reveal","op":"reveal","selector":{"semantic":"Hatifect.Flow/network/element/result"}},
    {"id":"sendFive-result-captured","op":"waitCapture","timeout":25,"path":"captures","afterCount":"${sendFiveCaptureBefore}","selector":{"semantic":"Hatifect.Flow/network/element/result"},"conditions":[{"path":"value","truthy":true}]},
    {"id":"sendFive-stage","op":"wait","timeout":30,"conditions":[{"source":"domain","path":"stage","equals":"close-window-for-transport"}]},
    {"id":"close-for-transport","op":"key","key":"Escape"},
    {"id":"wait-transport-window-closed","op":"waitUi","timeout":20,"visible":false},
    {"id":"wait-delivered-reopen-stage","op":"wait","timeout":300,"conditions":[{"source":"domain","path":"stage","equals":"ordinary-reopen-delivered-history"}]},
    {"id":"capture-partial-canonical","op":"capture","source":"domain","path":"fixture.partialParcelId","variable":"partialParcel","transform":"uuidCanonical"},
    {"id":"capture-partial-hex","op":"capture","source":"domain","path":"fixture.partialParcelId","variable":"partialHex","transform":"uuidHex"},
    {"id":"move-final-empty","op":"move","source":"domain","path":"fixture.emptyScreen"},
    {"id":"capture-final-entry-count","op":"capture","source":"domain","path":"entryAttempts","variable":"finalEntryBefore","transform":"count"},
    {"id":"capture-final-opening-count","op":"capture","source":"domain","path":"openings","variable":"finalOpenBefore","transform":"count"},
    {"id":"open-final-window","op":"key","key":"K"},
    {"id":"wait-final-opening","op":"wait","timeout":20,"conditions":[{"source":"domain","path":"entryAttempts","countGreaterThan":"${finalEntryBefore}"},{"source":"domain","path":"openings","countGreaterThan":"${finalOpenBefore}"}]},
    {"id":"assert-final-empty-target","op":"assert","conditions":[{"source":"domain","path":"openings[-1].target","uuidZero":true}]},
    {"id":"wait-final-window","op":"waitUi","timeout":30,"visible":true,"experience":"Hatifect.Flow/network"},
    {"id":"select-partial-history","op":"select","collection":"Hatifect.Flow/network/element/history","selector":{"semantic":"Hatifect.Flow/network/history/${partialHex}"}},
    {"id":"wait-delivered-history","op":"waitElement","timeout":30,"selector":{"semantic":"Hatifect.Flow/network/element/history-detail"},"conditions":[{"path":"value","startsWith":"${partialParcel} · "},{"path":"value","containsAny":[" · Delivered · attempts: 1"," · Доставлено · попыток: 1"]}]}
  ]
}