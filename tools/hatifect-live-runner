#!/usr/bin/env bash
set -euo pipefail
kind="${1:-}"
scenario="${2:-}"
result="${3:-}"
artifact_dir="${4:-}"
if [[ $# -eq 1 && ( "$kind" == "--help" || "$kind" == "-h" ) ]]; then
  printf '%s\n' "Usage: hatifect-live-runner <smoke|ui> <scenario> <result-json> <artifact-dir>"
  exit 0
fi
if [[ $# -ne 4 || ( "$kind" != "smoke" && "$kind" != "ui" ) || -z "$scenario" || "$scenario" == -* || -z "$result" || -z "$artifact_dir" ]]; then
  printf '%s\n' "ERROR: Usage: hatifect-live-runner <smoke|ui> <scenario> <result-json> <artifact-dir>" >&2
  exit 2
fi
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/_common.sh"
validator="$TOOLS_DIR/live-harness/validate.py"
user_session_runtime="$TOOLS_DIR/live-harness/user_session_runtime.py"
save_provisioner="$TOOLS_DIR/live-harness/save_provisioning.py"
semantic_test_agent="$TOOLS_DIR/live-harness/semantic-test-agent.py"
semantic_tests_root="$TOOLS_DIR/live-harness/semantic-tests"
semantic_spec="$semantic_tests_root/$scenario.json"
native_input_backend="$TOOLS_DIR/live-harness/macos_native_input_driver.py"
isolated_root="$(resolve_smapi_test_root)"
artifact_root="$REPO_ROOT/artifacts/runtime"

need_cmd python3
smapi="${HATIFECT_SMAPI_PATH:-}"

artifact_dir="$(python3 "$validator" assert-contained "$artifact_root" "$artifact_dir")"
result="$(python3 "$validator" assert-contained "$artifact_dir" "$result")"

if ! python3 "$validator" check-scenario "$kind" "$scenario" >/dev/null; then
  python3 "$validator" write-result FAIL "$scenario" "$result" \
    "Unknown or invalid live scenario." \
    --run-id "$(basename "$artifact_dir")" \
    --assertion-id HARNESS-SCENARIO \
    --artifact-root "$artifact_dir"
  exit 1
fi

mkdir -p "$artifact_dir"
scenario_timeout="$(python3 "$validator" check-scenario "$kind" "$scenario" --field timeoutSeconds)"
timeout_seconds="${HATIFECT_TEST_TIMEOUT_SECONDS:-$scenario_timeout}"
test_seed="${HATIFECT_TEST_SEED:-0}"
set +e
python3 "$user_session_runtime" preflight \
  --repository-root "$REPO_ROOT" \
  --kind "$kind" \
  --scenario "$scenario" \
  --isolated-root "$isolated_root" \
  --artifact-directory "$artifact_dir" \
  --result "$result" \
  --smapi-path "$smapi" \
  --timeout-seconds "$timeout_seconds" \
  --seed "$test_seed"
preflight_rc=$?
set -e
if (( preflight_rc != 0 )); then
  exit "$preflight_rc"
fi

requires_save="$(python3 "$validator" check-scenario "$kind" "$scenario" --field requiresSave)"
save_path=""
run_id="$(basename "$artifact_dir")"
if [[ "$scenario" == "save.bootstrap" ]]; then
  bootstrap_preflight_result="$(python3 "$save_provisioner" bootstrap-preflight \
    --isolated-root "$isolated_root" \
    --smapi-path "$smapi" \
    --run-id "$run_id" \
    --scenario "$scenario" \
    --artifact-directory "$artifact_dir" \
    --result "$result")" || exit $?
  if [[ "$bootstrap_preflight_result" == "HARNESS-SAVE-FIXTURE-EXISTS" ]]; then
    say "HARNESS-SAVE-FIXTURE-EXISTS: compatible verified fixture reuse PASS"
    exit 0
  fi
fi
if [[ "$requires_save" == "true" ]]; then
  save_path="$(python3 "$save_provisioner" plan \
    --isolated-root "$isolated_root" \
    --smapi-path "$smapi" \
    --run-id "$run_id" \
    --scenario "$scenario" \
    --artifact-directory "$artifact_dir" \
    --result "$result")" || exit $?
fi

python3 "$validator" check-scenario "$kind" "$scenario" > "$artifact_dir/instructions.txt"
say "Hatifect automated live harness"
say "Scenario: $scenario"
say "Transport: worktree runtime executor -> canonical owned direct process"
say "Isolated root: $isolated_root"
say "Artifacts: $artifact_dir"
say "Timeout: $timeout_seconds seconds"

arguments=(
  submit
  --repository-root "$REPO_ROOT"
  --kind "$kind"
  --scenario "$scenario"
  --isolated-root "$isolated_root"
  --artifact-directory "$artifact_dir"
  --result "$result"
  --timeout-seconds "$timeout_seconds"
  --seed "$test_seed"
)
if [[ -n "$save_path" ]]; then
  arguments+=(--save-path "$save_path")
fi

# A checked-in semantic spec is the only opt-in to an external GUI companion.
# Scenarios without one retain the exact historical one-process client handoff.
if [[ ! -f "$semantic_spec" ]]; then
  exec python3 "$user_session_runtime" "${arguments[@]}"
fi

if [[ "$(uname -s)" != "Darwin" || ! -f "$semantic_test_agent" || ! -f "$native_input_backend" ]]; then
  python3 "$validator" write-result BLOCKED "$scenario" "$result" \
    "The checked-in semantic workflow requires its macOS Quartz semantic-test agent and native input backend." \
    --run-id "$run_id" \
    --assertion-id HARNESS-SEMANTIC-TEST-AGENT \
    --artifact-root "$artifact_dir"
  exit 2
fi
need_cmd shasum
validator_sha256="$(shasum -a 256 "$validator")"
validator_sha256="${validator_sha256%% *}"
semantic_validator() {
  local current_sha256
  current_sha256="$(shasum -a 256 "$validator")"
  current_sha256="${current_sha256%% *}"
  if [[ "$current_sha256" != "$validator_sha256" ]]; then
    printf '%s\n' "Semantic diagnostics skipped: validator source changed during the run." \
      >> "$artifact_dir/harness.log"
    return 0
  fi
  if ! python3 "$validator" "$@"; then
    printf '%s\n' "Semantic diagnostics publication failed; canonical result is unchanged." \
      >> "$artifact_dir/harness.log"
  fi
}

semantic_agent_pid=""
semantic_agent_exit=""
cleanup_semantic_agent() {
  if [[ -z "$semantic_agent_pid" ]]; then
    return
  fi
  if kill -0 "$semantic_agent_pid" 2>/dev/null; then
    kill "$semantic_agent_pid" 2>/dev/null || true
  fi
  set +e
  wait "$semantic_agent_pid"
  semantic_agent_exit=$?
  set -e
  semantic_agent_pid=""
}
trap cleanup_semantic_agent EXIT INT TERM

say "Semantic input: checked-in workflow -> state-driven macOS Quartz agent"
semantic_validator record-event "$artifact_dir" "$scenario" "$run_id" \
  SemanticAgent.Started >/dev/null 2>&1
(
  set +e
  python3 "$semantic_test_agent" \
    --spec "$semantic_spec" \
    --artifact-directory "$artifact_dir" \
    --request-id "$run_id" \
    --scenario-id "$scenario" \
    --timeout-seconds "$timeout_seconds" \
    > "$artifact_dir/semantic-test-agent.log" 2>&1
  agent_exit=$?
  if (( agent_exit != 0 )); then
    printf '%s\n' "semantic-test-agent-failed" > "$artifact_dir/.cancel-requested.tmp"
    mv -f "$artifact_dir/.cancel-requested.tmp" "$artifact_dir/.cancel-requested"
  fi
  exit "$agent_exit"
) &
semantic_agent_pid=$!

set +e
python3 "$user_session_runtime" "${arguments[@]}"
runtime_exit=$?
set -e

if (( runtime_exit == 0 )); then
  for _ in {1..200}; do
    kill -0 "$semantic_agent_pid" 2>/dev/null || break
    sleep 0.05
  done
fi
cleanup_semantic_agent
trap - EXIT INT TERM

if [[ "$semantic_agent_exit" == "0" ]]; then
  semantic_validator record-event "$artifact_dir" "$scenario" "$run_id" \
    SemanticAgent.Completed >/dev/null 2>&1
else
  semantic_validator record-event "$artifact_dir" "$scenario" "$run_id" \
    SemanticAgent.Failed >/dev/null 2>&1
fi

semantic_failure_marker=false
if [[ -f "$artifact_dir/.cancel-requested" ]] \
  && grep -qx "semantic-test-agent-failed" "$artifact_dir/.cancel-requested" 2>/dev/null; then
  semantic_failure_marker=true
fi

if [[ "$semantic_failure_marker" == "true" ]] \
  || { (( runtime_exit == 0 )) && [[ "$semantic_agent_exit" != "0" ]]; }; then
  if [[ "$semantic_failure_marker" == "true" ]]; then
    semantic_failure_message="Semantic test companion exited ${semantic_agent_exit:-unknown}; the runtime cancellation is secondary."
  else
    semantic_failure_message="Semantic test companion exited ${semantic_agent_exit:-unknown} after the runtime completed successfully."
  fi
  printf '%s\n' "ERROR: $semantic_failure_message" >&2
  python3 "$validator" record-secondary-failure "$scenario" "$result" \
    "$semantic_failure_message" \
    --run-id "$run_id" \
    --assertion-id HARNESS-SEMANTIC-TEST-AGENT \
    --expected "The checked-in semantic test companion completes successfully." \
    --exception-type ProcessExit \
    --artifact-root "$artifact_dir"
  semantic_validator complete-scenario "$result" >/dev/null 2>&1
  if [[ -f "$artifact_dir/failure-summary.txt" ]]; then
    printf '%s\n' "--- failure-summary.txt ---" >&2
    cat "$artifact_dir/failure-summary.txt" >&2
  fi
  if (( runtime_exit != 0 )); then
    exit "$runtime_exit"
  fi
  exit 2
fi

semantic_validator complete-scenario "$result" >/dev/null 2>&1
exit "$runtime_exit"
