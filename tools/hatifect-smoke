#!/usr/bin/env bash
set -euo pipefail
scenario="${1:-}"
if [[ $# -eq 1 && ( "$scenario" == "--help" || "$scenario" == "-h" ) ]]; then
  printf '%s\n' "Usage: ./tools/hatifect-smoke <scenario-id>"
  exit 0
fi
if [[ $# -ne 1 || -z "$scenario" || "$scenario" == -* ]]; then
  printf '%s\n' "ERROR: Usage: ./tools/hatifect-smoke <scenario-id>" >&2
  exit 2
fi
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/_common.sh"
need_cmd python3

run_dir="$(new_runtime_run_dir)"
result="$run_dir/result.json"
validator="$TOOLS_DIR/live-harness/validate.py"
reproduction="$TOOLS_DIR/live-harness/reproduction.py"

if [[ -n "${HATIFECT_REPRO_SOURCE_RUN_ID:-}" ]]; then
  reproduction_from_phase="${HATIFECT_REPRO_FROM_PHASE:-preflight}"
  if ! reproduction_seed="$(python3 "$reproduction" materialize \
    "$HATIFECT_REPRO_SOURCE_RUN_ID" "$run_dir" smoke "$scenario" \
    --from "$reproduction_from_phase" --field seed)"; then
    python3 "$validator" write-result BLOCKED "$scenario" "$result" \
      "Targeted reproduction source evidence is invalid, stale, or unsafe." \
      --run-id "$(basename "$run_dir")" \
      --assertion-id HARNESS-REPRODUCTION-CHECKPOINT \
      --artifact-root "$run_dir"
    exit 2
  fi
  export HATIFECT_TEST_SEED="$reproduction_seed"
  unset HATIFECT_REPRO_SOURCE_RUN_ID HATIFECT_REPRO_FROM_PHASE
fi

say "Hatifect SMOKE"
say "Scenario: $scenario"
say "Artifacts: $run_dir"

if ! python3 "$validator" check-scenario smoke "$scenario" >/dev/null; then
  python3 "$validator" write-result FAIL "$scenario" "$result" \
    "Unknown or invalid smoke scenario." \
    --run-id "$(basename "$run_dir")" \
    --assertion-id HARNESS-SCENARIO \
    --artifact-root "$run_dir"
  exit 1
fi

set +e
"$TOOLS_DIR/hatifect-live-runner" smoke "$scenario" "$result" "$run_dir"
runner_rc=$?
set -e

if [[ ! -f "$result" ]]; then
  python3 "$validator" write-result BLOCKED "$scenario" "$result" \
    "Runtime runner exited $runner_rc and produced no result.json." \
    --run-id "$(basename "$run_dir")" \
    --assertion-id HARNESS-RESULT-MISSING \
    --exception-type ProcessExit \
    --artifact-root "$run_dir"
  exit 2
fi

if ! validate_result_json "$result" "$scenario"; then
  mv "$result" "$run_dir/runner-result.invalid.json"
  python3 "$validator" write-result BLOCKED "$scenario" "$result" \
    "Runtime runner produced malformed or mismatched result evidence." \
    --run-id "$(basename "$run_dir")" \
    --assertion-id HARNESS-RESULT-INVALID \
    --artifact-root "$run_dir"
  exit 2
fi
status="$(python3 "$validator" validate-result "$result" "$scenario" --field status)"
case "$status" in
  PASS)
    if [[ $runner_rc -ne 0 ]]; then
      mv "$result" "$run_dir/runner-result.conflicting.json"
      python3 "$validator" write-result BLOCKED "$scenario" "$result" \
        "Runtime runner exited $runner_rc despite reporting PASS." \
        --run-id "$(basename "$run_dir")" \
        --assertion-id HARNESS-RESULT-CONFLICT \
        --exception-type ProcessExit \
        --artifact-root "$run_dir"
      say "RESULT: BLOCKED (runner exit $runner_rc conflicts with PASS evidence)"
      exit 2
    fi
    say "RESULT: PASS"
    ;;
  FAIL)
    say "RESULT: FAIL"
    exit 1
    ;;
  BLOCKED)
    say "RESULT: BLOCKED"
    exit 2
    ;;
esac
