# Copy to tools/hatifect.env and edit locally.
# Do not commit machine-specific secrets or user paths.

# SDK 8 tooling materializes its build input from the authoritative Hatifect.slnx.
# Optional solution override is used only by the runtime preparation helper.
HATIFECT_SOLUTION=""

# Build configuration used by normal checks.
HATIFECT_CONFIGURATION="Release"

# Automated isolated macOS/SMAPI harness. Keep every mutable test path under .smapi-test by default.
HATIFECT_SMAPI_PATH=""

# Optional isolated-root override for migrated/protected worktrees. It must resolve below
# .smapi-test or to a hatifect-smapi-test.* directory below the operating-system temporary root.
HATIFECT_SMAPI_TEST_ROOT=""

# Optional deterministic runner controls. Scenario defaults remain authoritative when empty.
HATIFECT_TEST_TIMEOUT_SECONDS=""
HATIFECT_TEST_SEED=""

# Optional x64 .NET 8 paths used by ./tools/hatifect-live-prepare.
HATIFECT_LIVE_DOTNET=""
HATIFECT_LIVE_TEST_DOTNET=""

# The live prepare step normally relies on authoritative PR CI for host-free evidence.
# Set to 1 only when the local host-free suite should be repeated before isolated deploy.
HATIFECT_LIVE_RUN_HOST_FREE_TESTS="0"

# Optional extra validator executable.
# Signature:
#   <validator> <repo-root>
HATIFECT_VALIDATOR=""

# Set to 1 only after the project is ready to treat all build warnings as errors.
HATIFECT_WARNINGS_AS_ERRORS="0"
