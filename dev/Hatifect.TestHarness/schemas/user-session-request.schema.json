{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "user-session-request.schema.json",
  "title": "Hatifect user-session runtime request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocolVersion",
    "requestType",
    "requestId",
    "repositoryRoot",
    "repositoryDevice",
    "repositoryInode",
    "checkoutSha",
    "kind",
    "scenarioId",
    "isolatedRoot",
    "artifactDirectory",
    "resultPath",
    "savePath",
    "timeoutSeconds",
    "seed",
    "createdAtUtc",
    "expiresAtUtc"
  ],
  "properties": {
    "protocolVersion": { "const": 1 },
    "requestType": { "const": "executeDirectRuntime" },
    "requestId": { "type": "string", "format": "uuid" },
    "repositoryRoot": { "type": "string", "minLength": 1 },
    "repositoryDevice": { "type": "integer", "minimum": 0 },
    "repositoryInode": { "type": "integer", "minimum": 1 },
    "checkoutSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "kind": { "enum": ["smoke", "ui"] },
    "scenarioId": { "type": "string", "minLength": 1 },
    "isolatedRoot": { "type": "string", "minLength": 1 },
    "artifactDirectory": { "type": "string", "minLength": 1 },
    "resultPath": { "type": "string", "minLength": 1 },
    "savePath": { "type": ["string", "null"] },
    "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 7200 },
    "seed": { "type": "integer", "minimum": -2147483647, "maximum": 2147483647 },
    "createdAtUtc": { "type": "string", "format": "date-time" },
    "expiresAtUtc": { "type": "string", "format": "date-time" }
  }
}
