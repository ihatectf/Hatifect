{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scenario.schema.json",
  "title": "Hatifect TestHarness scenario v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocolVersion",
    "id",
    "description",
    "assertions"
  ],
  "properties": {
    "protocolVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z0-9-]+)+$"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "requiredGameState": {
      "type": "string",
      "minLength": 1
    },
    "timeoutSeconds": {
      "type": "integer",
      "minimum": 1
    },
    "deterministicSeed": {
      "type": "integer"
    },
    "assertions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
